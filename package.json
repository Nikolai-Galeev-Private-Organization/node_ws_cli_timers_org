  },
  "homepage": "https://github.com/emirotin/node-template#readme",
  "dependencies": {
    "body-parser": "^1.19.0",
    "dotenv": "^18.0.9",
    "express": "^4.17.1",
    "migrate-mongo": "^14.0.7",
    "mongodb": "^7.7.0",
    "nanoid": "^3.1.10",
    "ws": "^8.23.0"
  }
}
